# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
/dist

# Legacy Next.js / OpenNext output. No longer produced, but it lingers in
# checkouts that built the old app and must never be committed.
/.next/
/.open-next/
/out/
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env / secrets. Wrangler reads .dev.vars for local secrets; .env is the
# pre-migration convention and is still ignored so old checkouts stay safe.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.dev.vars
.dev.vars.*
!.dev.vars.example

# typescript
*.tsbuildinfo

# bun
bun.lockb
bun.lock

/.cursor

# Cloudflare (local D1 / R2 / KV state, generated deploy config)
.wrangler/

# UI probe output (scripts/ui-probe.mjs)
.probe-profile*
probe-*/

# LobeHub reference clone (read-only source for the migration; not part of this repo's history)
/new/

# Auto-generated by the old Next.js tooling; lingers in old checkouts.
next-env.d.ts

# Scratch output from the Playwright MCP browser tools.
.playwright-mcp/
