{
  "name": "openchat",
  "version": "0.2.0",
  "private": true,
  "author": "singhsarfaraz5507@gmail.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src scripts vite.config.ts vitest.config.ts eslint.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --env-file .dev.vars.example",
    "db:migrate:local": "wrangler d1 migrations apply openchat --local",
    "prepare": "husky || true",
    "sync:disposable-domains": "node scripts/sync-disposable-domains.mjs",
    "check:disposable-domains": "node scripts/sync-disposable-domains.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint",
      "prettier --write"
    ],
    "*.{json,jsonc,md,css,yml,html}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.114",
    "@cloudflare/sandbox": "0.12.9",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "ai": "^6.0.286",
    "geist": "^1.7.2",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
